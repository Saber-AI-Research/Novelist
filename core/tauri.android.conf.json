{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "identifier": "com.novelist.app",
  "app": {
    "windows": [
      {
        "title": "Novelist"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/plugins/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": null
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "resources": [],
    "fileAssociations": null,
    "android": {
      "minSdkVersion": 26
    }
  }
}
