# Copy to .env (git-ignored) and edit. This file holds no secrets: passwords
# are Docker secret files in ./secrets, created by ./init-secrets.sh.

# Public host name of the server (DNS must point at your TLS proxy).
# Required; it becomes the Nextcloud trusted domain.
NEXTCLOUD_DOMAIN=

# Loopback port for compose.yaml without compose.npm.yaml.
NEXTCLOUD_HTTP_PORT=8080

# Largest single upload (Nextcloud syntax, e.g. 512M, 1G).
PHP_UPLOAD_LIMIT=1G
PHP_MEMORY_LIMIT=512M

# A TLS reverse proxy on this host forwarding to 127.0.0.1:NEXTCLOUD_HTTP_PORT
# (not needed with compose.npm.yaml). Example values:
#   NEXTCLOUD_OVERWRITE_PROTOCOL=https
#   NEXTCLOUD_OVERWRITE_HOST=<NEXTCLOUD_DOMAIN>
#   NEXTCLOUD_OVERWRITE_CLI_URL=https://<NEXTCLOUD_DOMAIN>
NEXTCLOUD_OVERWRITE_PROTOCOL=
NEXTCLOUD_OVERWRITE_HOST=
NEXTCLOUD_OVERWRITE_CLI_URL=

# compose.npm.yaml only: uncomment COMPOSE_FILE so every `docker compose`
# command includes the override, then set the external Docker network Nginx
# Proxy Manager uses and its subnet
# (docker network inspect <network> -f '{{(index .IPAM.Config 0).Subnet}}').
# COMPOSE_FILE=compose.yaml:compose.npm.yaml
NPM_NETWORK=proxy
NPM_PROXY_SUBNET=

# Image pins (bump Nextcloud one major version at a time; see README.md).
# NEXTCLOUD_IMAGE=nextcloud:34.0.5-apache
# MARIADB_IMAGE=mariadb:11.8.9-noble
# REDIS_IMAGE=redis:8.10.3-trixie
